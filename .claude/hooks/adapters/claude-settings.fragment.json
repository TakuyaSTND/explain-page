{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/understanding-composer.py\" --runtime claude --project-root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Artifact|open_preview",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/understanding-composer.py\" --runtime claude --project-root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/understanding-composer.py\" --runtime claude --project-root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/understanding-composer.py\" --runtime claude --project-root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|overloaded|authentication_failed|oauth_org_not_allowed|billing_error|invalid_request|model_not_found|server_error|max_output_tokens|unknown",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/understanding-composer.py\" --runtime claude --project-root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
